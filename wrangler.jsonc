// SPDX-License-Identifier: AGPL-3.0-only
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spamgram",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5
  },
  "triggers": {
    "crons": ["* * * * *", "0 */2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spamgram",
      "database_id": "2110c2aa-0afe-469a-8aa2-4b92a55b0e23",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCOUNT_AGE_MIN_DAYS": "120",
    "APPROVE_WINDOW_MINUTES": "120",
    "JOIN_FLOOD_LIMIT": "4",
    "JOIN_FLOOD_WINDOW_MINUTES": "1",
    "SCAN_COOLDOWN_MINUTES": "180",
    "SCAM_TEXT_THRESHOLD": "4",
    "RESCAN_HOURS": "12",
    "RESCAN_LIMIT": "100"
  }
}